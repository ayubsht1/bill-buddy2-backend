SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL runs outside Docker.
DB_ENGINE=django.db.backends.mysql
DATABASE_NAME=bill_buddy
DB_USER=bill_buddy
DB_PASSWORD=replace-with-your-local-mysql-password
DB_HOST=127.0.0.1
DB_PORT=3306

# Optional integrations.
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
# Keep eager mode on for local development without a running worker.
CELERY_TASK_ALWAYS_EAGER=True
GOOGLE_CLIENT_ID=
GEMINI_API_KEY=

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=no-reply@billbuddy.local

FRONTEND_URL=http://localhost:3000
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:3000
